# Copy this file to .env and fill in your key.
#   cp .env.example .env

API_KEY=paste-your-key-here

# Any OpenAI-compatible endpoint works -- just change these two.
BASE_URL=https://api.experientiallabs.ai/v1
MODEL=gpt-6-astra

# Other providers:
#   Google AI Studio  https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.5-flash
#   OpenAI            https://api.openai.com/v1                                  gpt-4o-mini
#   Groq              https://api.groq.com/openai/v1                             llama-3.3-70b-versatile
#   DeepSeek          https://api.deepseek.com/v1                                deepseek-chat
#   OpenRouter        https://openrouter.ai/api/v1                               anthropic/claude-sonnet-4.5
#   Ollama (local)    http://localhost:11434/v1

# "openai" for /chat/completions, "anthropic" for /messages (test.py only)
STYLE=openai

# Optional system prompt used by chat.py and the web UI
SYSTEM=You are a helpful assistant.
